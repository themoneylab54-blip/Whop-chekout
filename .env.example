# Postgres (Neon, Supabase, Vercel Postgres, local…)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whop_checkout"

# Public URL of this app, no trailing slash. Must be HTTPS in production
# (Shopify OAuth callback, Whop webhooks and the storefront loader use it).
APP_URL="http://localhost:3000"

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Encrypts Shopify/Whop secrets at rest. Never change it once stores are connected.
ENCRYPTION_KEY=""

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Optional: code required on /setup to create the first admin account
# SETUP_TOKEN=""

# Optional: unexpected server errors to Sentry (HTTP envelope API, scrubbed of personal data)
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
# SENTRY_SAMPLE_RATE="1"

# Optional: checkout domains (Réglages → Domaine du checkout) added to the Vercel project
# automatically, with their DNS status. Without them, add each domain in Vercel → Settings → Domains.
# VERCEL_API_TOKEN=""
# VERCEL_PROJECT_ID="prj_…"
# VERCEL_TEAM_ID="team_…"   # only when the project belongs to a team

# Optional: the operator's other hosts of this deployment (dashboard alias, marketing domain…),
# comma-separated. Served as the app (never as a store's checkout domain) and refused as one.
# OPERATOR_HOSTS="admin.mondomaine.com,www.mondomaine.com"

# Optional: Stripe Connect as a second processor (dashboard → Stripe). The operator's platform
# account: enable Connect, then Settings → Connect → OAuth: copy the client id (ca_…) and add the
# redirect URI <APP_URL>/api/stripe/connect/callback. Test keys are used for stores in test mode.
# STRIPE_SECRET_KEY="sk_live_…"
# STRIPE_PUBLISHABLE_KEY="pk_live_…"
# STRIPE_CLIENT_ID="ca_…"
# STRIPE_TEST_SECRET_KEY="sk_test_…"
# STRIPE_TEST_PUBLISHABLE_KEY="pk_test_…"
# STRIPE_TEST_CLIENT_ID="ca_…"
# Only when the Connect webhook was created by hand (the app creates it and stores its secret):
# STRIPE_WEBHOOK_SECRET="whsec_…"
# STRIPE_TEST_WEBHOOK_SECRET="whsec_…"
