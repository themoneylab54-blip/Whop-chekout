generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Store {
  id        String   @id @default(cuid())
  // Opaque id embedded in the storefront loader; never the internal id.
  publicId  String   @unique @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Shopify ---
  shopDomain            String?  @unique
  shopifyClientId       String?
  shopifyClientSecret   String? // encrypted
  shopifyAccessToken    String? // encrypted, offline token
  shopifyScopes         String?
  shopifyOauthState     String?
  shopCurrency          String   @default("EUR")
  // Primary storefront host (custom domain), used to validate return URLs
  storefrontHost        String?
  scriptTagId           String?
  shopifyConnectedAt    DateTime?

  // --- Whop ---
  whopApiKey        String? // encrypted
  whopAccountId     String?
  whopProductId     String?
  whopWebhookId     String?
  whopWebhookSecret String? // encrypted
  whopConnectedAt   DateTime?

  // --- State ---
  enabled  Boolean @default(false) // master switch: false = native Shopify checkout
  testMode Boolean @default(true) // Whop sandbox + Shopify test orders

  // --- Settings (validated by zod in src/lib/layout) ---
  theme          Json?
  checkoutLayout Json?
  thankYouLayout Json?
  interception   Json?

  shippingRates ShippingRate[]
  discounts     DiscountCode[]
  addOns        AddOn[]
  sessions      CheckoutSession[]
}

model ShippingRate {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  deliveryTime    String?
  // ISO 3166-1 alpha-2 codes; empty = every country in the store's list
  countries       String[]
  priceCents      Int
  // free when the discounted subtotal reaches this amount
  freeOverCents   Int?
  position        Int      @default(0)
  active          Boolean  @default(true)
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model DiscountCode {
  id            String       @id @default(cuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  type          DiscountType
  // percent: 1-100 ; fixed: cents ; free shipping: ignored
  value         Int
  minSubtotalCents Int?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([storeId, code])
}

model AddOn {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priceCents  Int
  // when set, the add-on is a real Shopify variant added to the order
  variantId   String?
  imageUrl    String?
  position    Int     @default(0)
  active      Boolean @default(true)
}

enum SessionStatus {
  OPEN
  PAYING
  PAID
  FAILED
  ABANDONED
}

model CheckoutSession {
  id        String        @id @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status    SessionStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paidAt    DateTime?

  currency  String
  // Server-priced cart lines: CartLine[] (src/lib/pricing.ts)
  lines     Json
  // Selected add-on ids
  addOnIds  String[]
  discountCode String?
  shippingRateId String?

  // Totals in cents, computed server-side at pay time
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  addOnsCents   Int @default(0)
  totalCents    Int @default(0)

  // Customer
  email           String?
  acceptsMarketing Boolean @default(false)
  shippingAddress Json?

  // Attribution
  returnUrl String?
  utm       Json?

  // Whop
  whopCheckoutId String?
  whopPaymentId  String? @unique

  // Shopify sync
  shopifyOrderId   String?
  shopifyOrderName String?
  syncError        String?
  // Lease taken while creating the Shopify order (prevents duplicates on webhook retries)
  syncStartedAt    DateTime?
  refundedCents    Int     @default(0)
  disputed         Boolean @default(false)

  @@index([storeId, createdAt])
  @@index([storeId, status])
}

model WebhookEvent {
  id         String   @id // webhook-id header
  storeId    String
  type       String
  receivedAt DateTime @default(now())
}
