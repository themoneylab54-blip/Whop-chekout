generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Store {
  id        String   @id @default(cuid())
  // Opaque id embedded in the storefront loader; never the internal id.
  publicId  String   @unique @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Shopify ---
  shopDomain            String?  @unique
  shopifyClientId       String?
  shopifyClientSecret   String? // encrypted
  shopifyAccessToken    String? // encrypted, offline token
  shopifyScopes         String?
  shopifyOauthState     String?
  shopCurrency          String   @default("EUR")
  // Primary storefront host (custom domain), used to validate return URLs
  storefrontHost        String?
  scriptTagId           String?
  shopifyConnectedAt    DateTime?

  // --- Whop ---
  whopApiKey        String? // encrypted
  whopAccountId     String?
  whopProductId     String?
  whopWebhookId     String?
  whopWebhookSecret String? // encrypted
  whopConnectedAt   DateTime?

  // --- State ---
  enabled  Boolean @default(false) // master switch: false = native Shopify checkout
  testMode Boolean @default(true) // Whop sandbox + Shopify test orders

  // --- Settings (validated by zod in src/lib/layout) ---
  // Published design (what buyers see)
  theme          Json?
  checkoutLayout Json?
  thankYouLayout Json?
  interception   Json?
  // Builder drafts: autosaved here, copied to the fields above on "Publier"
  draftTheme          Json?
  draftCheckoutLayout Json?
  draftThankYouLayout Json?
  draftUpdatedAt      DateTime?
  publishedAt         DateTime?

  // --- Payments ---
  // Extra Whop payment methods offered on top of card/wallets/PayPal (e.g. alma, bancontact)
  paymentMethods      String[] @default([])
  // Shown on the buyer's bank statement (new Whop products / upsell charges)
  statementDescriptor String?

  // --- Ads tracking (server-side conversions) ---
  metaPixelId       String?
  metaAccessToken   String? // encrypted
  metaTestEventCode String?
  tiktokPixelId     String?
  tiktokAccessToken String? // encrypted

  // --- Abandoned checkout recovery (e-mails via Resend) ---
  recoveryEnabled     Boolean @default(false)
  recoveryConsentOnly Boolean @default(true)
  recoveryCode        String?
  resendApiKey        String? // encrypted
  emailFrom           String?

  // --- Alerts ---
  alertEmail       String?
  telegramBotToken String? // encrypted
  telegramChatId   String?

  // --- Dispute shield ---
  pushTracking          Boolean @default(true)
  autoDisputeEvidence   Boolean @default(true)
  autoRefundFraudAlerts Boolean @default(false)

  // --- Health ---
  lastWebhookAt DateTime?

  shippingRates ShippingRate[]
  discounts     DiscountCode[]
  addOns        AddOn[]
  sessions      CheckoutSession[]
  versions      LayoutVersion[]
  experiments   Experiment[]
  events        EventLog[]
}

model ShippingRate {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  deliveryTime    String?
  // ISO 3166-1 alpha-2 codes; empty = every country in the store's list
  countries       String[]
  priceCents      Int
  // free when the discounted subtotal reaches this amount
  freeOverCents   Int?
  position        Int      @default(0)
  active          Boolean  @default(true)
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model DiscountCode {
  id            String       @id @default(cuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  type          DiscountType
  // percent: 1-100 ; fixed: cents ; free shipping: ignored
  value         Int
  minSubtotalCents Int?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([storeId, code])
}

model AddOn {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priceCents  Int
  // when set, the add-on is a real Shopify variant added to the order
  variantId   String?
  imageUrl    String?
  position    Int     @default(0)
  active      Boolean @default(true)
}

enum SessionStatus {
  OPEN
  PAYING
  PAID
  FAILED
  ABANDONED
}

model CheckoutSession {
  id        String        @id @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status    SessionStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paidAt    DateTime?

  currency  String
  // Server-priced cart lines: CartLine[] (src/lib/pricing.ts)
  lines     Json
  // Selected add-on ids
  addOnIds  String[]
  discountCode String?
  shippingRateId String?

  // Totals in cents, computed server-side at pay time
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  addOnsCents   Int @default(0)
  totalCents    Int @default(0)

  // Customer
  email           String?
  acceptsMarketing Boolean @default(false)
  // Buyer's note from the "order_note" block, copied to the Shopify order
  note             String?
  shippingAddress Json?

  // Attribution
  returnUrl String?
  utm       Json?

  // Whop — checkout configuration prepared for `preparedTotalCents` (one-page checkout)
  whopCheckoutId     String?
  preparedTotalCents Int?
  whopPaymentId  String? @unique

  // Shopify sync
  shopifyOrderId   String?
  shopifyOrderName String?
  syncError        String?
  // Lease taken while creating the Shopify order (prevents duplicates on webhook retries)
  syncStartedAt    DateTime?
  refundedCents    Int     @default(0)
  disputed         Boolean @default(false)
  // Set when a payment needs a human look (amount/country/code mismatch, extra payment):
  // the Shopify order is then only created by a manual "sync" from the dashboard.
  reviewNote       String?
  // Automatic retries of the Shopify sync (exponential backoff)
  syncAttempts     Int       @default(0)
  nextSyncAt       DateTime?

  // Funnel
  contactAt     DateTime? // e-mail captured
  preparedAt    DateTime? // payment form ready
  payClickedAt  DateTime? // buyer clicked "Pay"
  termsAcceptedAt DateTime?

  // Attribution & ads (fbp, fbc, ttp, ttclid, marketing consent…)
  tracking   Json?
  clientIp   String?
  userAgent  String?
  pixelSentAt DateTime?

  // A/B test
  experimentId String?
  variant      String?

  // Upsell: the saved payment method from the first payment
  whopMemberId        String?
  whopPaymentMethodId String?
  upsells             UpsellCharge[]

  // Abandoned checkout recovery
  recoveryStage  Int       @default(0)
  recoverySentAt DateTime?

  // Dispute shield
  trackingNumber    String?
  trackingPushedAt  DateTime?
  trackingCheckedAt DateTime?
  disputeEvidenceAt DateTime?
  // Snapshot of the exact quote the buyer paid (see CheckoutQuote)
  paidQuoteId      String?
  quotes           CheckoutQuote[]

  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([status, createdAt])
}

model WebhookEvent {
  id         String   @id // webhook-id header
  storeId    String
  type       String
  receivedAt DateTime @default(now())
  // Raw event body, kept for audit and replay
  payload    Json?
}

/// Audit trail and alert source: every notable thing that happens to a store.
model EventLog {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessionId String?
  level     String   // info | warn | error
  kind      String   // e.g. order.synced, sync.failed, review.hold, dispute.created
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([sessionId])
}

/// Published designs, for history/restore and A/B tests.
model LayoutVersion {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label          String
  theme          Json
  checkoutLayout Json
  thankYouLayout Json
  createdAt      DateTime @default(now())

  @@index([storeId, createdAt])
}

/// A/B test: variant B renders a saved LayoutVersion to `splitB`% of new checkouts.
model Experiment {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  versionId String
  splitB    Int       @default(50)
  status    String    @default("RUNNING") // RUNNING | STOPPED
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([storeId, status])
}

/// One-click post-purchase offer charged on the saved payment method.
model UpsellCharge {
  id               String          @id @default(cuid())
  sessionId        String
  session          CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blockId          String
  title            String
  variantId        String
  amountCents      Int
  status           String          @default("PENDING") // PENDING | PAID | FAILED | DECLINED
  whopPaymentId    String?         @unique
  shopifyOrderId   String?
  shopifyOrderName String?
  error            String?
  createdAt        DateTime        @default(now())

  @@unique([sessionId, blockId])
}

/// Shared fixed-window counters (works across serverless instances).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// App-wide settings (e.g. the Apple Pay domain-association file served on this domain).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One row per Whop checkout configuration: the exact quote it charges.
/// The paid configuration — not the session's latest state — drives the Shopify order.
model CheckoutQuote {
  id                   String          @id @default(cuid())
  sessionId            String
  session              CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  whopCheckoutId       String          @unique
  fingerprint          String
  currency             String
  subtotalCents        Int
  discountCents        Int
  shippingCents        Int
  addOnsCents          Int
  totalCents           Int
  shippingRateId       String?
  shippingRateName     String?
  // Countries the rate covers (empty = everywhere)
  shippingCountries    String[]
  discountCode         String?
  discountFreeShipping Boolean         @default(false)
  // [{ id, title, priceCents, variantId }]
  addOns               Json
  addOnIds             String[]
  createdAt            DateTime        @default(now())

  @@index([sessionId, fingerprint])
}
